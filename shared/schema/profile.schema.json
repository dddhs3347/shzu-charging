{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shzu.profile.v1",
  "title": "Profile",
  "type": "object",
  "required": ["schema", "vendor", "base_url", "requests", "field_paths"],
  "properties": {
    "schema": { "const": "shzu.profile.v1" },
    "vendor": { "type": "string" },
    "applet_name": { "type": "string" },
    "learned_at": { "type": "string" },
    "base_url": { "type": "string" },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "method", "url"],
        "properties": {
          "name": { "type": "string" },
          "method": { "type": "string" },
          "url": { "type": "string" },
          "headers": { "type": "object" },
          "body": { "type": ["string", "null"] },
          "content_type": { "type": ["string", "null"] }
        }
      }
    },
    "field_paths": {
      "type": "object",
      "properties": {
        "list": { "type": ["string", "null"] },
        "station_id": { "type": ["string", "null"] },
        "station_name": { "type": ["string", "null"] },
        "area": { "type": ["string", "null"] },
        "device_list": { "type": ["string", "null"] },
        "device_id": { "type": ["string", "null"] },
        "device_code": { "type": ["string", "null"] },
        "device_status": { "type": ["string", "null"] },
        "lat": { "type": ["string", "null"] },
        "lng": { "type": ["string", "null"] }
      }
    },
    "status_map": {
      "type": "object",
      "properties": {
        "free": { "type": "array", "items": { "type": "string" } },
        "busy": { "type": "array", "items": { "type": "string" } },
        "offline": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "string" }
  }
}
