# 复制成 .env 再改（.env 不要提交到 git，里面有口令）
#
# 采集口令（32 位）。来源：仓库里 cloudflare/out/collector_token.txt，
# 或者问部署这个服务的人要。填错的话 Worker 会返回 403，日志里能看到。
SHZU_CLOUD_TOKEN=在这里填32位口令

# 云中转地址。用官方线上服务就保持默认；
# 如果你自己部署了 Worker（fork 了这个项目），改成你自己的域名。
SHZU_CLOUD=https://api.shzucharge.xyz

# ---- 可选：想改节奏就取消注释 ----
# SHZU_CLOUD_MIN_INTERVAL=120   # 每 120 秒往云端推一次（用户要求「一分钟内更新」，建议 120）
# SHZU_INTERVAL=15              # 源 A 采集间隔
# LVCC_INTERVAL=300             # 源 B 采集间隔（被官方风控，别小于 180）
# SHZU_WORKERS=16               # 源 A 并发数，NAS 很弱可以降到 6
# RELAY_PORT=8080               # 局域网 relay 端口
# RELAY_RETAIN_DAYS=30          # SQLite 里历史保留多少天