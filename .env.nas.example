# 复制成 .env.nas 再改（.env.nas 已在 .gitignore 里，不会进 git）
#
# 采集口令（32 位）：仓库里的 cloudflare/out/collector_token.txt，或找部署方要。
# 填错/为空时，云端 Worker 会返回 403，容器日志里能看到。
SHZU_CLOUD_TOKEN=在这里填32位口令

# 云中转地址。用线上服务保持默认；自己部署了 Worker 就换成自己的域名。
SHZU_CLOUD=https://api.shzucharge.xyz

# ---- 可选：想改节奏就取消注释 ----
# SHZU_CLOUD_MIN_INTERVAL=120
# SHZU_INTERVAL=15
# LVCC_INTERVAL=300
# SHZU_WORKERS=16
# RELAY_PORT=8080
# RELAY_RETAIN_DAYS=30